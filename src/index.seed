          @div class=mt-8 grid sm:grid-cols-2 gap-4
            @div class=rounded-2xl bg-white p-6 border border-[#31C795]/25
              @strong class=font-black
                Firewall
              @p class=mt-2 text-sm text-slate-600
                Barra ameaças antes da entrada na rede.

            @div class=rounded-2xl bg-white p-6 border border-[#31C795]/25
              @strong class=font-black
                Antivírus gerenciado
              @p class=mt-2 text-sm text-slate-600
                Proteção sempre atualizada.

            @div class=rounded-2xl bg-white p-6 border border-[#31C795]/25
              @strong class=font-black
                Backup automático
              @p class=mt-2 text-sm text-slate-600
