          @img src=/static/informatica-previa.png, alt="Prévia das peças Konectai de informática", class=relative w-full rounded-[2rem] shadow-2xl border border-white

  @section id=seguranca, class=scroll-mt-24 px-5 py-24 bg-[#ECFBF5]
    @div data-reveal=true, class=max-w-7xl mx-auto opacity-0 -translate-x-24 transition-all duration-700 ease-out
      @div class=grid lg:grid-cols-2 gap-12 xl:gap-16 items-center
        @div
