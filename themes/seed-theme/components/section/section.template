@container class=flex flex-col gap-4
  @div class=absolute inset-0 -z-10
    {?background}

  @span class=text-teal-600 font-semibold text-sm uppercase tracking-wide
    {?label}
  @h2 as=h2, class=text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mt-2
    {?title}
  @p as=p, class=text-gray-600 text-base sm:text-lg mt-2
    {?description}

@div class=mt-12
  {?children}
